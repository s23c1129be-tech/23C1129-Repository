import argparse
import math
import sys
from collections import deque


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="chanvage",
        description="Compute a moving average on numerical stdin with optional max-step clamping.",
    )
    parser.add_argument(
        "-n",
        "--window",
        type=int,
        default=3,
        help="Moving average window size (positive integer, default: 3).",
    )
    parser.add_argument(
        "-m",
        "--max-step",
        type=float,
        default=None,
        help="Maximum allowed change from previous output value (non-negative float).",
    )
    return parser.parse_args(argv)


def clamp_step(current: float, previous: float | None, max_step: float | None) -> float:
    if max_step is None or previous is None:
        return current
    diff = current - previous
    if diff > max_step:
        return previous + max_step
    if diff < -max_step:
        return previous - max_step
    return current


def run_filter(lines, window: int, max_step: float | None, out) -> int:
    if window <= 0:
        print("Error: --window must be greater than 0.", file=sys.stderr)
        return 1
    if max_step is not None and (math.isnan(max_step) or max_step < 0.0):
        print("Error: --max-step must be non-negative.", file=sys.stderr)
        return 1

    buf: deque[float] = deque(maxlen=window)
    prev_val: float | None = None

    for line_no, raw in enumerate(lines, start=1):
        text = raw.strip()
        if not text:
            continue
        try:
            val = float(text)
        except ValueError:
            print(f"Error: invalid number at line {line_no}: {text}", file=sys.stderr)
            return 1
        if not math.isfinite(val):
            print(f"Error: non-finite number at line {line_no}: {text}", file=sys.stderr)
            return 1

        buf.append(val)
        avg = sum(buf) / len(buf)
        result = clamp_step(avg, prev_val, max_step)
        out.write(f"{result}\n")
        prev_val = result

    return 0


def main() -> int:
    args = parse_args(sys.argv[1:])
    return run_filter(sys.stdin, args.window, args.max_step, sys.stdout)


if __name__ == "__main__":
    sys.exit(main())
